# Backend API — must live in THIS folder (`onTripe frontend/.env`), not the repo root.
# Restart the dev server (`npm run dev`) after any change. Rebuild (`npm run build`) for production.
#
# Either form works (trailing slashes are OK):
#   VITE_API_BASE_URL=https://your-domain.com/api
#   VITE_API_BASE_URL=https://your-domain.com

VITE_API_BASE_URL=https://ontrip.itfuturz.in/api
